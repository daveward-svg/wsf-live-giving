n:1.3vh 0 0;color:#f5f1e7;font-size:clamp(.72rem,1.05vw,1.08rem);font-weight:650}.footer{position:absolute;z-index:4;left:4vw;right:4vw;bottom:2.3vh;display:grid;grid-template-columns:1fr auto;align-items:center;gap:1.4vw;padding-top:1.7vh;border-top:1px solid rgba(255,255,255,.2)}.priorities{display:flex;align-items:center;gap:1.1vw;font-size:clamp(.58rem,.9vw,.95rem);font-weight:850;letter-spacing:.04em}.priorities i{width:1px;height:1.3em;background:rgba(255,255,255,.5)}.give-button{text-decoration:none;color:#111820;background:#efbd43;padding:1.1vh 1.8vw;border-radius:999px;font-weight:1000;letter-spacing:.08em;font-size:clamp(.8rem,1.1vw,1.1rem)}.connection{grid-column:1/-1;position:absolute;right:0;bottom:-1.9vh;display:flex;gap:.6rem;font-size:.58rem;opacity:.45}.goal-celebration{position:fixed;z-index:30;inset:0;display:grid;place-items:center;background:radial-gradient(circle,rgba(239,189,67,.3),rgba(4,12,22,.94) 64%);opacity:0;visibility:hidden;transition:.8s}.goal-celebration.visible{opacity:1;visibility:visible}.goal-celebration div{text-align:center}.goal-celebration small{display:block;letter-spacing:.25em;font-weight:900}.goal-celebration strong{display:block;color:#efbd43;font-size:clamp(4rem,12vw,13rem);line-height:.9}.goal-celebration span{font-size:clamp(1.2rem,3vw,3rem);font-weight:900;letter-spacing:.08em}#confetti{position:fixed;inset:0;z-index:40;pointer-events:none;width:100%;height:100%}@media(max-aspect-ratio:4/3){.hero{grid-template-columns:1fr;padding-top:3vh}.campaign-copy{text-align:center}.campaign-copy h1 em{display:inline}.live-card{justify-self:center;width:min(92vw,900px)}.impact-strip{display:none}.priorities{display:none}.footer{grid-template-columns:1fr;justify-items:center}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
